+        if size <= 0 || size > budget {
+            rejected.push(index);
+            consumed = index + 1;
+            continue;
+        }
+        if bytes + size > budget {
+            break;
+        }
+        bytes += size;
+        selected.push(index);
+        consumed = index + 1;
+    }
+    (consumed, selected, rejected)

  "default_api_calls_per_page": null,
  "scope": "Request recipes under explicit finite fixture state. No rates, weight distribution, production origins or integrated pageview multiplier are inferred. Counts exclude conditional lanes unless explicitly included.",
  "accounting": {
    "one_permit_per_actual_http_attempt": true,
    "read_only_post_queries_consume_permit": true,
    "read_query_is_not_state_mutation": true,
    "retry_attempts_consume_permit": true,
    "redirects_must_not_escape_budget": true,
    "default_device_progress_http_writes": 0,
    "response_byte_caps_required_before_dispatch": true,
    "byte_caps_and_latencies": "Must be explicit scenario admission inputs/actual observations, not invented from these source counts."
  },
  "endpoints": {
    "chapter": {
      "method": "GET",
      "path": "/api/v1/chapter/{chapterUuid}",
      "effect": "read",
      "lane": "reader"
    },
    "manga_candidates": {
      "method": "GET",
      "path": "/api/v1/manga",
      "effect": "read",
      "query": "exact ids[] in batches<=100; includes[]=cover_art,author,artist",
      "lane": "catalogue"
    },
    "forum_context": {
      "method": "POST",
      "path": "/api/v1/nostr/native-forum/contexts",
      "effect": "read",
      "body": "exact typed resources<=100; this POST is a read query",
      "lane": "catalogue"
    },
    "at_home": {
      "method": "GET",
      "path": "/api/v1/at-home/server/{chapterUuid}",
      "effect": "read",
      "lane": "reader"
    },
    "aggregate": {
      "method": "GET",
      "path": "/api/v1/manga/{mangaUuid}/aggregate",
      "effect": "read",
      "lane": "reader"
    },
    "selector_page": {
      "method": "GET",
      "path": "/api/v1/chapter",
      "effect": "read",
      "query": "manga exact UUID; limit100; offset; actual selector language/group/preferences/includes",
      "lane": "reader"
    },
    "manga_search": {
      "method": "GET",
      "path": "/api/v1/manga",
      "effect": "read",
      "query": "translated actual search filters, limit/offset/includes",
      "lane": "catalogue"
    },
    "manga_tags": {
      "method": "GET",
      "path": "/api/v1/manga/tag",
      "effect": "read",
      "query": "limit100; page translated to offset",
      "lane": "catalogue"
    },
    "original_image": {
      "method": "GET",
      "path": "{verifiedAtHomeBase}/data/{hash}/{filename}",
      "effect": "media-read",
      "urlSource": "actual validated atHomePages.public_url; do not synthesize hash/name",
      "lane": "media"
    },
    "data_saver_image": {
      "method": "GET",
      "path": "{verifiedAtHomeBase}/data-saver/{hash}/{filename}",
      "effect": "media-read",
      "urlSource": "actual validated optimized page URL only",
      "lane": "media"
    },
    "chapter_view": {
      "method": "POST",
      "path": "/api/v1/analytics/chapter/{chapterUuid}/views",
      "effect": "analytics-write",
      "lane": "analytics"
    },
    "scope": {
      "method": "GET",
      "path": "/api/protocol/capabilities",
      "effect": "read",
      "lane": "setup"
    },
    "session": {
      "method": "GET",
      "path": "/api/auth/check",
      "effect": "read",
      "lane": "setup"
    },
    "native_chapter": {
      "method": "GET",
      "path": "/api/chapter/{nativeId}",
      "effect": "read",
      "lane": "reader"
    },
    "native_aggregate": {
      "method": "GET",
      "path": "/api/manga/{nativeId}/aggregate",
      "effect": "read",
      "lane": "reader"
    }
  },
